# NEXUS IDE Configuration
# DeepSeek is the PRIMARY AI provider
# Environment: development (change to 'staging' or 'production' for other environments)
ENVIRONMENT=production

# Ollama Configuration (SECONDARY - DeepSeek is the primary provider)
OLLAMA_HOST=http://localhost:11434
OLLAMA_DASHBOARD_HOST=http://localhost:11435

# Redis Configuration
# When REDIS_URL is set, rate limiting automatically uses Redis instead of in-memory storage.
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_PASSWORD=

# Web Search Configuration
BRAVE_API_KEY=
# Optional: DuckDuckGo is used as fallback if BRAVE_API_KEY is not set

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=WARNING
DEBUG=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Observability Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
ENABLE_TRACING=false
ENABLE_METRICS=true

# Security Configuration
# IMPORTANT: Change these before deploying to production!
# Generate new keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# CORS Origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
DATABASE_URL=sqlite:///./data/nexus.db

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# LLM_PROVIDER=openrouter
# LLM_PROVIDER=dev
LLM_PROVIDER=opencode_go

# Auto-login Development Credentials
NEXT_PUBLIC_AUTO_LOGIN=true
NEXT_PUBLIC_DEV_EMAIL=admin@nexus-ide.com
NEXT_PUBLIC_DEV_PASSWORD=admin123

# AirLLM Experimental Configuration (adicionado automaticamente)
AIRLLM_EXPERIMENTAL_ENABLED=false
LOCAL_LLM_DEVICE=auto
LOCAL_LLM_COMPRESSION=
LOCAL_LLM_DASHBOARD_DEVICE=cpu

# Auto-Commit Git Configuration
AUTO_COMMIT_ENABLED=true
AUTO_COMMIT_STRATEGY=always
AUTO_COMMIT_MODEL=auto

# AI Provider API Keys (uncomment and fill in to use cloud providers)
# OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-4XYklGp2bvKqL1JPMRgKhXTiQwMrOMKi8omRtxp9ukGdFyx7SK4GZSiUPjG3Dox8
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# KIMI_API_KEY=...
# GROQ_API_KEY=...
# ANTHROPIC_API_KEY=...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-9mRJ0edfsghRIjywcCebNJURAvBGpClOq8G7R4vKMaaxAhmseH3rw9E3icltupnY

# OpenCode Go (https://opencode.ai/zen/go/v1)
# Same key used by the OpenClaw agent — stored in proxy/opencode-proxy.js
# Leave commented to use a runtime key via /api/settings or fallback to dev provider.
# Use local proxy to bypass Cloudflare; proxy forwards to https://opencode.ai/zen/go/v1
# OpenAIProvider appends /v1/chat/completions, so the base should NOT include /v1
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_API_KEY=sk-FvfFEloVB0OVDPwtOxN9CRicpMvNhJcbnaC5fBRsucYmyuRdnejUtzQP2T4kR3xA
OPENCODE_GO_DEFAULT_MODEL=glm-5.2

# Production Settings
ENABLE_TRACING=true
ENABLE_METRICS=true
SECURE_COOKIES=true
SESSION_TIMEOUT=1800
