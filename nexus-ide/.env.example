# =============================================================================
# NEXUS IDE Configuration — EXAMPLE FILE
# =============================================================================
# WARNING: This file contains example / default values. NEVER commit real
# secrets to version control. Copy this file to .env and override ALL secret
# values with cryptographically strong random strings before deploying to
# production.
# =============================================================================

# Environment: development (change to 'staging' or 'production' for other environments)
ENVIRONMENT=development

# Primary LLM Provider
# Default: openrouter (OpenRouter API). Set to "ollama" if you want to use local models.
# Supported: openrouter, ollama, openai, deepseek, kimi, groq, anthropic, gemini, opencode_go
LLM_PROVIDER=openrouter

# =============================================================================
# OpenCode Go Configuration (PRIMARY CLOUD PROVIDER)
# =============================================================================
# Get your API key at https://opencode.ai/zen/go
# This is the recommended and default provider.
OPENCODE_GO_API_KEY=your-opencode-go-api-key-here
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# =============================================================================
# Optional: Local Ollama (only enabled if NEXUS_ENABLE_OLLAMA=true)
# =============================================================================
# Uncomment the line below to enable Ollama as an optional fallback.
# Note: Ollama is NOT enabled by default. Set NEXUS_ENABLE_OLLAMA=true to use it.
# NEXUS_ENABLE_OLLAMA=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_DASHBOARD_HOST=http://localhost:11434

# =============================================================================
# Optional: Other cloud providers (only registered if their API key is set)
# =============================================================================
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# KIMI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=sk-or-v1-...

# --- Tool calling (autonomous missions) ---
# Native OpenAI-compatible function calling. ON by default: agents send a
# structured tool schema so even small/free models return parseable tool_calls
# instead of hand-writing the <tool_call> wrapper (the main reason autonomous
# missions failed the evidence gate). Set to 0 to fall back to prompt-only.
NEXUS_NATIVE_TOOL_CALLING=1
# Optional: pin EVERY tier to one tool-capable OpenRouter model. The default
# NEXUS tiers map to small free models that are unreliable at function calling.
# Point this at a model your account can reach that supports the `tools` param,
# e.g. openai/gpt-4o-mini (paid) or a current free tool-capable model.
# NEXUS_OPENROUTER_TOOL_MODEL=openai/gpt-4o-mini

# AirLLM Experimental Configuration
# Keep disabled unless you explicitly want to test the experimental backend.
AIRLLM_EXPERIMENTAL_ENABLED=false
# Device: auto (detects CUDA), cuda:0, or cpu
LOCAL_LLM_DEVICE=auto
# Compression: empty (none), 4bit, or 8bit
LOCAL_LLM_COMPRESSION=
# Dashboard uses lighter device to save VRAM
LOCAL_LLM_DASHBOARD_DEVICE=cpu

# Redis Configuration
# When REDIS_URL is set, rate limiting automatically uses Redis instead of in-memory storage.
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_PASSWORD=

# Web Search Configuration
BRAVE_API_KEY=
# Optional: DuckDuckGo is used as fallback if BRAVE_API_KEY is not set

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
DEBUG=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
# Maximum browser-side safety window for one chat stream (30 minutes by default).
NEXT_PUBLIC_CHAT_STREAM_TIMEOUT_MS=1800000

# Observability Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
ENABLE_TRACING=false
ENABLE_METRICS=true

# Security Configuration
SECRET_KEY=development-secret-key-change-in-production
# Generate a strong secret key for production using: python -c "import secrets; print(secrets.token_urlsafe(32))"
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# JWT Authentication Configuration
JWT_SECRET=change-this-secret-in-production-use-env-var
# Generate a strong JWT secret for production using: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Database Configuration
DATABASE_URL=sqlite:///./data/nexus.db

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Auto-Commit Git Configuration
# Automatically commit file changes after write operations
AUTO_COMMIT_ENABLED=false
AUTO_COMMIT_STRATEGY=disabled
AUTO_COMMIT_MODEL=auto

# =============================================================================
# Background autonomy services
# =============================================================================
# All background services (dashboard agent, guardian, self-healing, AI
# orchestrator, auto-trigger, improvement loops...) are ON by default in
# every environment, including development — NEXUS is a local-first
# autonomous IDE and this stack is the product.
#
# Master kill-switch (useful for tests/CI or minimal-footprint runs):
# NEXUS_BACKGROUND_SERVICES=off
#
# Per-service opt-out (set any of these to false to disable just one):
# NEXUS_ENABLE_BACKGROUND_WORKERS=false
# NEXUS_ENABLE_DASHBOARD_AGENT=false
# NEXUS_ENABLE_GUARDIAN_AGENT=false
# NEXUS_ENABLE_AUTO_CORRECTION=false
# NEXUS_ENABLE_EXEC_ENGINE=false
# NEXUS_ENABLE_CONTINUOUS_IMPROVEMENT=false
# NEXUS_ENABLE_SELF_IMPROVEMENT=false
# NEXUS_ENABLE_SELF_HEALING=false
# NEXUS_ENABLE_AI_ORCHESTRATOR=false
# NEXUS_ENABLE_AUTO_TRIGGER=false
# NEXUS_ENABLE_SESSION_GC=false

# =============================================================================
# Autonomy & Self-Improvement (Task 10 — conservative defaults)
# =============================================================================
# When true, the SelfImprovementAnalyzer may APPLY proposals automatically.
# When false, proposals are surfaced for operator approval only via the
# authenticated /api/self_improvement/apply endpoint.
NEXUS_AUTO_APPLY=false

# When true (the default), ProposalApplier runs a dry-run + test-suite check
# before declaring success and only then applies the change. Set to false
# only in trusted test environments.
NEXUS_AUTO_APPLY_DRY_RUN=true

# When true, the EventBus replays persisted events to subscribers on startup,
# bounded by the retention window. Useful for catching up on missed events
# after a restart, but doubles startup work — keep off unless you need it.
NEXUS_EVENT_REPLAY=false

# Retention window for the on-disk event store (in hours). Replay only
# covers this window.
NEXUS_EVENT_RETENTION_HOURS=24

# When true, the MemoryBank runs a periodic decay sweep that removes entries
# whose importance is below the configured threshold. Off by default — turn
# on only after you have validated the threshold for your workload.
NEXUS_MEMORY_DECAY=false
NEXUS_MEMORY_DECAY_THRESHOLD=0.2
NEXUS_MEMORY_DECAY_INTERVAL_HOURS=24

# Circuit breaker for the auto-correction self-heal re-planner. Caps the
# number of re-plans the loop may issue per process per hour.
NEXUS_SELF_HEAL_MAX_PER_HOUR=5

# Test command ProposalApplier runs before declaring a dry-run "ok".
# Override for non-standard test layouts.
NEXUS_PROPOSAL_TEST_CMD=python -m pytest backend/tests -q --maxfail=1

# Maximum duration of one autonomous orchestration step. The run checkpoint
# remains durable even if this safety limit is reached.
NEXUS_AUTONOMOUS_STEP_TIMEOUT=900

# Safety budget for ReAct tool iterations when a mode leaves max_iterations at
# 0. Positive per-request budgets still take precedence; this prevents an
# upstream model from keeping a task alive forever while remaining resumable.
NEXUS_REACT_MAX_ITERATIONS=24
