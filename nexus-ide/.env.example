# =============================================================================
# NEXUS IDE Configuration — EXAMPLE FILE
# =============================================================================
# WARNING: This file contains example / default values. NEVER commit real
# secrets to version control. Copy this file to .env and override ALL secret
# values with cryptographically strong random strings before deploying to
# production.
# =============================================================================

# Environment: development (change to 'staging' or 'production' for other environments)
ENVIRONMENT=development

# Primary LLM Provider
# Default: openrouter (OpenRouter API). Set to "ollama" if you want to use local models.
# Supported: openrouter, ollama, openai, deepseek, kimi, groq, anthropic, gemini, opencode_go
LLM_PROVIDER=openrouter
# Free-model execution policy (fail closed by default)
NEXUS_FREE_ONLY=true
NEXUS_PROVIDER_VALIDATION_TTL_SECONDS=600
NEXUS_MAX_PROVIDER_LATENCY_MS=30000

# =============================================================================
# Cost governor (audit 2026-08-24) — OBRIGATÓRIO antes de usar chaves pagas
# =============================================================================
# Cap ABSOLUTO de gasto LLM por dia UTC (dólares). O default deixou de ser
# 0 (SEM LIMITE): com chaves pagas em data/settings.json e MULTI_LLM_ENABLED=false,
# um teto de 0 é o mesmo que nenhum teto. 25 USD/dia é ~10x o gasto típico de um
# dia de desenvolvimento e corta runaway agent loops antes de queimar a conta.
# 0 = ilimitado (o backend loga um warning crítico a cada arranque nesse caso).
# O saldo sobrevive a restarts: cada chamada paga é gravada na tabela
# usage_ledger (data/nexus.db) e verificada ANTES de qualquer despacho —
# inclusive no caminho ResilientLLMProvider, que é o cliente real por omissão.
NEXUS_DAILY_BUDGET_USD=25
# Cap opcional por run/agente (dólares). Aplicado quando o run_id/session_id é
# propagado ao provider. 2 USD por run impede que um único agente em loop
# consuma o orçamento diário inteiro. 0 = desativado.
NEXUS_PER_RUN_BUDGET_USD=2
# Taxas conservadoras para modelos com preço DESCONHECIDO (B4): em modo
# pago, desconhecido nunca conta $0 — usa estes tetos por 1M tokens.
NEXUS_UNKNOWN_PRICE_USD_PER_1M_INPUT=2.5
NEXUS_UNKNOWN_PRICE_USD_PER_1M_OUTPUT=10

# =============================================================================
# OpenCode Go Configuration (PRIMARY CLOUD PROVIDER)
# =============================================================================
# Get your API key at https://opencode.ai/zen/go
# This is the recommended and default provider.
OPENCODE_GO_API_KEY=your-opencode-go-api-key-here
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# =============================================================================
# LM Studio Configuration (Optional — local OpenAI-compatible server)
# =============================================================================
# Enable LM Studio as a provider. Set NEXUS_ENABLE_LMSTUDIO=true to use it.
NEXUS_ENABLE_LMSTUDIO=false
LMSTUDIO_HOST=http://localhost:1234/v1
LMSTUDIO_API_KEY=

# =============================================================================
# Ollama Configuration (Optional — local LLM runner)
# =============================================================================
# Uncomment the line below to enable Ollama as an optional fallback.
# Note: Ollama is NOT enabled by default. Set NEXUS_ENABLE_OLLAMA=true to use it.
# NEXUS_ENABLE_OLLAMA=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_DASHBOARD_HOST=http://localhost:11434

# =============================================================================
# Optional: Other cloud providers (only registered if their API key is set)
# =============================================================================
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# KIMI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=sk-or-v1-...

# --- Tool calling (autonomous missions) ---
# Native OpenAI-compatible function calling. ON by default: agents send a
# structured tool schema so even small/free models return parseable tool_calls
# instead of hand-writing the <tool_call> wrapper (the main reason autonomous
# missions failed the evidence gate). Set to 0 to fall back to prompt-only.
NEXUS_NATIVE_TOOL_CALLING=1
# Optional: pin EVERY tier to one tool-capable OpenRouter model. The default
# NEXUS tiers map to small free models that are unreliable at function calling.
# Point this at a model your account can reach that supports the `tools` param,
# e.g. openai/gpt-4o-mini (paid) or a current free tool-capable model.
# NEXUS_OPENROUTER_TOOL_MODEL=openai/gpt-4o-mini

# =============================================================================
# LM Studio Configuration (local OpenAI-compatible inference)
# =============================================================================
# Set LLM_PROVIDER=lmstudio to use LM Studio as the primary provider.
# LM Studio runs locally on http://localhost:1234 by default.
# NEXUS_ENABLE_OLLAMA=false is recommended when using LM Studio exclusively.
LMSTUDIO_HOST=http://localhost:1234/v1
LMSTUDIO_API_KEY=
# Optional: pin per-tier model ids (override the catalog defaults).
# Leave blank to use the built-in defaults resolved from the LM Studio server.
LMSTUDIO_DEFAULT_MODEL=
LMSTUDIO_FAST_MODEL=
LMSTUDIO_CODER_MODEL=
# Read timeout in seconds for LM Studio requests (cold model load is slow).
LMSTUDIO_READ_TIMEOUT=600

# AirLLM Experimental Configuration
# Keep disabled unless you explicitly want to test the experimental backend.
AIRLLM_EXPERIMENTAL_ENABLED=false
# Device: auto (detects CUDA), cuda:0, or cpu
LOCAL_LLM_DEVICE=auto
# Compression: empty (none), 4bit, or 8bit
LOCAL_LLM_COMPRESSION=
# Dashboard uses lighter device to save VRAM
LOCAL_LLM_DASHBOARD_DEVICE=cpu

# Redis Configuration
# When REDIS_URL is set, rate limiting automatically uses Redis instead of in-memory
# storage. (This is now actually true — see backend/middleware/rate_limit.py. A
# non-Redis REDIS_URL is ignored for rate limiting and logged, not fatal.)
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_PASSWORD=

# Web Search Configuration
BRAVE_API_KEY=
# Optional: DuckDuckGo is used as fallback if BRAVE_API_KEY is not set

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
# Rotação de logs (audit P1-8). logs/backend.log cresce sem limite sem isto.
# NEXUS_LOG_MAX_BYTES=10MB        tamanho por ficheiro antes de rodar
# NEXUS_LOG_BACKUP_COUNT=5         número de ficheiros rodados mantidos
# NEXUS_LOG_MAX_TOTAL_BYTES=100MB  tecto TOTAL (evita 300 ficheiros de 1 MB)
# NEXUS_LOG_RETENTION_DAYS=30      retenção da tabela structured_logs
# NEXUS_LOG_PRUNE_INTERVAL_SECONDS=21600  intervalo da limpeza (6 h)
DEBUG=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
# Maximum browser-side safety window for one chat stream (30 minutes by default).
NEXT_PUBLIC_CHAT_STREAM_TIMEOUT_MS=1800000

# Observability Configuration
# Traces: setup_tracing() é chamado no lifespan QUANDO ENABLE_TRACING=true e
# OTEL_EXPORTER_OTLP_ENDPOINT está definido (exporter OTLP gRPC). Com
# ENABLE_TRACING=false nada é exportado — os spans ficam só no store in-memory.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Prometheus exposition: servida em GET /metrics (text/plain, sem auth) a partir
# do registo prometheus_client. config/prometheus.yml faz scrape de
# backend:8000 com o metrics_path por omissão (/metrics), que agora existe.
PROMETHEUS_PORT=9090
ENABLE_TRACING=false
ENABLE_METRICS=true

# Security Configuration
SECRET_KEY=development-secret-key-change-in-production
# Generate a strong secret key for production using: python -c "import secrets; print(secrets.token_urlsafe(32))"
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Health probes (audit P1-5) ---
# GET /health e GET /api/health são LIVENESS: baratos e SEM autenticação, para
# que um probe de orquestrador nunca seja bloqueado por uma falha de auth.
# GET /health?deep=true, /health/deep, /api/deep e /api/system/health exigem
# Bearer token: devolvem topologia interna (LLM, workers, guardian, Redis).
# GET /api/ready é o readiness probe (sem auth) e tem probes registados, logo
# pode — e deve — devolver not_ready quando uma dependência está em baixo.
# Resposta é HTTP 200 com o veredicto no corpo (contrato documentado);
# use GET /api/ready?strict=true para obter HTTP 503 quando não estiver ready
# (orquestradores que só olham para o status code).

# JWT Authentication Configuration
JWT_SECRET=change-this-secret-in-production-use-env-var
# Generate a strong JWT secret for production using: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Database Configuration
DATABASE_URL=sqlite:///./data/nexus.db

# Rate Limiting
# IMPLEMENTADO (audit P0-2): o limiter está ligado em backend/orchestrator/main.py
# (app.state.limiter + middleware + handler 429). Estas duas variáveiscontrolam o
# limite GLOBAL por IP; rotas com @limiter.limit(...) usam o limite próprio.
# RATE_LIMIT_ENABLED=false deixa o limiter instalado (os decoradores continuam a
# funcionar) mas desliga apenas o limite global por omissão.
# O armazenamento passa a ser Redis quando REDIS_URL está definido (isto já era
# documentado abaixo e agora é verdade); caso contrário fica em memória.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# Limites por classe de endpoint (sobrescrevem o catálogo interno).
# NEXUS_RATE_LIMIT_AUTH=5/minute
# NEXUS_RATE_LIMIT_CHAT=60/minute
# NEXUS_RATE_LIMIT_LLM=30/minute
# NEXUS_RATE_LIMIT_FILES=30/minute
# NEXUS_RATE_LIMIT_TERMINAL=30/minute
# NEXUS_RATE_LIMIT_TESTS=5/minute
# NEXUS_RATE_LIMIT_DASHBOARD=200/minute
# NEXUS_RATE_LIMIT_DEFAULT=200/minute

# =============================================================================
# POST /api/tests/run — contentamento (audit P0-1)
# =============================================================================
# O endpoint é ADMIN-ONLY e corre pytest (execução de código arbitrário) apenas
# dentro de uma raiz autorizada, com timeout obrigatório, e fora do event loop.
# Roots autorizadas, separadas por ';' (por omissão: a raiz do repositório).
# NEXUS_TEST_RUN_ALLOWED_ROOTS=C:/Users/you/Desktop;/srv/projects
# Dependências extra: só são aceites pins exactos nome==versão de pacotes numa
# lista de nomes permitidos (separados por vírgula).
# NEXUS_TEST_RUN_ALLOWED_DEPS=pytest,httpx,respx
# NEXUS_TEST_RUN_PYTEST_TIMEOUT_SECONDS=600
# NEXUS_TEST_RUN_PIP_TIMEOUT_SECONDS=180
# Instalar project_path/requirements.txt é OFF por omissão (conteúdo controlável
# por terceiros = dependency confusion). Active apenas em repositório de confiança.
# NEXUS_TEST_RUN_INSTALL_REQUIREMENTS=false
# NEXUS_TEST_RUN_ENSURE_DEPS=true

# Auto-Commit Git Configuration
# Automatically commit file changes after write operations
AUTO_COMMIT_ENABLED=false
AUTO_COMMIT_STRATEGY=disabled
AUTO_COMMIT_MODEL=auto

# =============================================================================
# Background autonomy services
# =============================================================================
# All background services (dashboard agent, guardian, self-healing, AI
# orchestrator, auto-trigger, improvement loops...) are ON by default in
# every environment, including development — NEXUS is a local-first
# autonomous IDE and this stack is the product.
#
# Master kill-switch (useful for tests/CI or minimal-footprint runs):
# NEXUS_BACKGROUND_SERVICES=off
#
# Per-service opt-out (set any of these to false to disable just one):
# NEXUS_ENABLE_BACKGROUND_WORKERS=false
# NEXUS_ENABLE_DASHBOARD_AGENT=false
# NEXUS_ENABLE_GUARDIAN_AGENT=false
# NEXUS_ENABLE_AUTO_CORRECTION=false
# NEXUS_ENABLE_EXEC_ENGINE=false
# NEXUS_ENABLE_CONTINUOUS_IMPROVEMENT=false
# NEXUS_ENABLE_SELF_IMPROVEMENT=false
# NEXUS_ENABLE_SELF_HEALING=false
# NEXUS_ENABLE_AI_ORCHESTRATOR=false
# NEXUS_ENABLE_AUTO_TRIGGER=false
# NEXUS_ENABLE_SESSION_GC=false

# =============================================================================
# Autonomy & Self-Improvement (Task 10 — conservative defaults)
# =============================================================================
# When true, the SelfImprovementAnalyzer may APPLY proposals automatically.
# When false, proposals are surfaced for operator approval only via the
# authenticated /api/self_improvement/apply endpoint.
NEXUS_AUTO_APPLY=false

# When true (the default), ProposalApplier runs a dry-run + test-suite check
# before declaring success and only then applies the change. Set to false
# only in trusted test environments.
NEXUS_AUTO_APPLY_DRY_RUN=true

# NOTE (audit de flags mortas): NEXUS_EVENT_REPLAY e NEXUS_EVENT_RETENTION_HOURS
# NÃO são lidos por nenhum módulo. Foram removidos em vez de documentados, porque
# uma flag documentada e inerte é pior do que a ausência da flag: dá a falsa
# impressão de que a replay do EventBus está implementada. Ver
# docs/auditorias/ para a lista completa de flags removidas.

# NOTE (audit de flags mortas): NEXUS_MEMORY_DECAY, NEXUS_MEMORY_DECAY_THRESHOLD e
# NEXUS_MEMORY_DECAY_INTERVAL_HOURS NÃO são lidos por nenhum módulo. Removidos
# pelo mesmo motivo acima: documentar um decay de memória que não existe convida
# quem o configura a acreditar que a memória está a decair.

# Circuit breaker for the auto-correction self-heal re-planner. Caps the
# number of re-plans the loop may issue per process per hour.
NEXUS_SELF_HEAL_MAX_PER_HOUR=5

# Test command ProposalApplier runs before declaring a dry-run "ok".
# Override for non-standard test layouts.
NEXUS_PROPOSAL_TEST_CMD=python -m pytest backend/tests -q --maxfail=1

# Maximum duration of one autonomous orchestration step. The run checkpoint
# remains durable even if this safety limit is reached.
NEXUS_AUTONOMOUS_STEP_TIMEOUT=900

# Safety budget for ReAct tool iterations when a mode leaves max_iterations at
# 0. Positive per-request budgets still take precedence; this prevents an
# upstream model from keeping a task alive forever while remaining resumable.
NEXUS_REACT_MAX_ITERATIONS=24

# =============================================================================
# Tool reasoning visibility (on-screen "painel de raciocínio")
# =============================================================================
# How much of the model's reasoning may reach the browser. Always bounded; this
# only chooses WHICH bound.
#   label (default) — one operational line, <= 160 chars: what the agent is
#                    about to do. Never a private chain of thought.
#   full            — the model's own reasoning text, <= 4000 chars. Use only on
#                    trusted machines; a reasoning transcript is far more
#                    revealing than the answer.
#   off             — nothing is emitted and the panel stays empty.
# The UI's "thinking strength" control can only NARROW this (low/medium/high
# unlock `full` when the operator already set it, never grant it themselves).
# An unknown value falls back to `label`, never to `full`.
NEXUS_REASONING_VISIBILITY=label
